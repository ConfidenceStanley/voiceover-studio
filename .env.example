# Get a key at https://fish.audio (Developer / API keys)
FISH_API_KEY=your_api_key_here

# Free API model. Change to another model string if Fish Audio ends the free model.
FISH_MODEL=s2.1-pro-free

# Which engine to use (only "fish" for now)
TTS_ENGINE=fish
PORT=3000

# Login for the hosted app (leave ACCESS_PASSWORD empty to disable)
ACCESS_USER=admin
ACCESS_PASSWORD=choose_a_strong_password
